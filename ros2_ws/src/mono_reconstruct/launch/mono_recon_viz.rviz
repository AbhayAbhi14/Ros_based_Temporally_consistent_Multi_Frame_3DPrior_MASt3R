Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true

    - Class: rviz_default_plugins/Image
      Name: Depth Image
      Enabled: true
      Image Topic: /mast3r/depth

    - Class: rviz_default_plugins/PointCloud2
      Name: MASt3R Point Cloud
      Enabled: true
      Topic: /mast3r/pointcloud
      Size (m): 0.01
      Color Transformer: FlatColor
      Color: 0;255;0  # Green — raw MASt3R output

    - Class: rviz_default_plugins/PointCloud2
      Name: Fused Point Cloud
      Enabled: true
      Topic: /mast3r/fused_pointcloud
      Size (m): 0.01
      Color Transformer: FlatColor
      Color: 255;0;0  # Red — temporally fused cloud

    - Class: rviz_default_plugins/PointCloud2
      Name: Global Map
      Enabled: true
      Topic: /mast3r/global_map
      Size (m): 0.01
      Color Transformer: FlatColor
      Color: 0;0;255  # Blue — global reconstruction

  Global Options:
    Fixed Frame: map
    Background Color: 0;0;0  # Black background

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Pitch: 0.785
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
